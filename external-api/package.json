{
  "name": "external-api",
  "version": "1.0.0",
  "private": true,
  "description": "DTFS External API",
  "keywords": [
    "export",
    "finance"
  ],
  "homepage": "https://github.com/UK-Export-Finance/dtfs2#readme",
  "bugs": {
    "url": "https://github.com/UK-Export-Finance/dtfs2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UK-Export-Finance/dtfs2.git"
  },
  "license": "MIT",
  "author": "UK Export Finance",
  "main": "server/index.ts",
  "scripts": {
    "api-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --forceExit --runInBand --config=api-test.jest.config.js",
    "api-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --forceExit --runInBand --config=api-test.jest.config.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.{ts,js} --ignore-path ../.prettierignore",
    "prettier:fix": "prettier --write **/*.{ts,js} --ignore-path ../.prettierignore",
    "start": "npx ts-node server/index.ts",
    "start:dev": "npx nodemon server/index.ts --config ../nodemon.json",
    "type-check": "tsc --noEmit --pretty",
    "unit-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.jest.config.js",
    "unit-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=unit.jest.config.js",
    "unit-test-ff": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.ff.jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/lodash": "^4.17.25",
    "@types/validator": "13.15.10",
    "@ukef/dtfs2-common": "1.0.0",
    "axios": "1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^6.11.2",
    "joi": "^18.2.9",
    "lodash": "^4.18.1",
    "mongodb": "^4.17.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@ukef/eslint-local-rules": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "nock": "^14.0.17",
    "node-mocks-http": "^1.18.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.3.0"
  },
  "engineStrict": true
}
