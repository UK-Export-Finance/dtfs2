{
  "name": "acbs",
  "version": "1.0.0",
  "private": true,
  "description": "ACBS DOF",
  "keywords": [
    "export",
    "finance"
  ],
  "homepage": "https://github.com/UK-Export-Finance/dtfs2#readme",
  "bugs": {
    "url": "https://github.com/UK-Export-Finance/dtfs2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UK-Export-Finance/dtfs2.git"
  },
  "license": "MIT",
  "author": "UK Export Finance",
  "main": "src/functions/*.js",
  "scripts": {
    "api-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --runInBand --config=api-test.jest.config.js ",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.js --ignore-path ../../.prettierignore",
    "prettier:fix": "prettier --write **/*.js --ignore-path ../../.prettierignore",
    "unit-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.jest.config.js",
    "unit-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=unit.jest.config.js",
    "unit-test-ff": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.ff.jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "axios": "1.20.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "durable-functions": "^3.3.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "babel-jest": "29.5.0",
    "babel-loader": "9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.3.0"
  },
  "engineStrict": true
}
