{
  "name": "gef-ui",
  "version": "1.0.0",
  "private": true,
  "description": "DTFS GEF UI",
  "keywords": [
    "export",
    "finance"
  ],
  "homepage": "https://github.com/UK-Export-Finance/dtfs2#readme",
  "bugs": {
    "url": "https://github.com/UK-Export-Finance/dtfs2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UK-Export-Finance/dtfs2.git"
  },
  "license": "MIT",
  "author": "UK Export Finance",
  "main": "index.ts",
  "scripts": {
    "api-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --runInBand --forceExit --config=api-test.jest.config.js",
    "api-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --runInBand --forceExit --config=api-test.jest.config.js",
    "build": "rimraf ./public/js && rimraf ./public/css && webpack --mode production --config webpack.prod.config.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.{ts,js} --ignore-path ../.prettierignore",
    "prettier:fix": "prettier --write **/*.{ts,js} --ignore-path ../.prettierignore",
    "start": "npx ts-node server/index.ts",
    "start:dev": "npx nodemon server/index.ts --config ../nodemon.json",
    "type-check": "tsc --noEmit --pretty",
    "unit-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.jest.config.js",
    "unit-test-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose --config=unit.jest.config.js",
    "unit-test-ff": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose --config=unit.ff.jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "11.1.0",
    "@ukef/dtfs2-common": "1.0.0",
    "ajv": "^8.20.0",
    "axios": "1.21.0",
    "chance": "^1.1.13",
    "cheerio": "1.2.0",
    "clean-deep": "^3.4.0",
    "comma-number": "^2.1.0",
    "compression": "^1.8.2",
    "connect-flash": "0.1.1",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.51.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.7.1",
    "filesize": "11.0.29",
    "form-data": "4.0.6",
    "govuk-frontend": "^5.13.0",
    "http-errors": "^2.0.1",
    "imask": "^7.6.1",
    "joi": "^18.3.0",
    "jquery": "4.0.0",
    "lodash": "^4.18.1",
    "morgan": "^1.12.1",
    "multer": "2.5.0",
    "node-fetch": "^3.3.2",
    "nunjucks": "3.2.4",
    "path": "0.12.7",
    "redis": "^6.3.0",
    "sanitize-html": "2.18.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/runtime": "8.0.0",
    "@eslint/js": "9.39.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-when": "^3.5.5",
    "@types/lodash": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "chokidar": "^4.0.3",
    "cookie-signature": "^1.2.2",
    "cross-env": "^10.1.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.5.5",
    "file-loader": "^6.2.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-when": "^4.0.3",
    "node-mocks-http": "^1.18.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "supertest": "^7.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.3.0"
  },
  "engineStrict": true
}
